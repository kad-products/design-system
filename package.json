{
	"name": "@kad-products/design-system",
	"version": "1.0.4",
	"description": "Design System for KAD's products",
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/design-system.js"
		},
		"./styles.css": "./dist/style.css"
	},
	"main": "./dist/design-system.js",
	"module": "./dist/design-system.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write .",
		"build": "vite build",
		"ci:lint": "pnpm biome:check && pnpm knip:check && pnpm prettier:check && pnpm types:check",
		"ci:tests": "pnpm playwright:run",
		"dev": "storybook dev -p 6006",
		"knip:check": "knip",
		"knip:fix": "knip --fix",
		"playwright:run": "playwright test",
		"playwright:ui": "playwright test --ui",
		"playwright:update": "playwright test --update-snapshots",
		"prepare": "husky",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"staged:lint": "lint-staged --allow-empty",
		"storybook:build": "storybook build",
		"storybook:dev": "storybook dev -p 6006",
		"types:check": "tsc --noEmit"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		],
		"package.json": [
			"prettier --write"
		],
		"*.{css,less}": [
			"prettier --write"
		],
		"worker-configuration.d.ts": []
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@radix-ui/react-icons": "^1.3.2",
		"classnames": "^2.5.1",
		"radix-ui": "^1.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@chromatic-com/storybook": "latest",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-onboarding": "^10.6.0",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/react": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.0.0",
		"@vitest/browser-playwright": "latest",
		"@vitest/coverage-v8": "latest",
		"husky": "^9.1.7",
		"knip": "^6.37.0",
		"lint-staged": "^17.0.0",
		"playwright": "latest",
		"prettier": "^3.8.2",
		"prettier-plugin-packagejson": "^3.0.2",
		"storybook": "^10.6.0",
		"typescript": "^5.6.0",
		"vite": "^8.0.0",
		"vite-plugin-dts": "^4.2.0",
		"vitest": "latest"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"packageManager": "pnpm@12.4.2",
	"publishConfig": {
		"access": "restricted",
		"registry": "https://npm.pkg.github.com"
	}
}
